{
  "name": "voron8",
  "version": "3.2.0",
  "description": "CGAL segment Voronoi diagram of points, segments, and polygons, in WebAssembly — edges labeled interior/exterior, vertices traced back to input geometry.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewjacobson/voron8.git"
  },
  "homepage": "https://github.com/matthewjacobson/voron8#readme",
  "bugs": "https://github.com/matthewjacobson/voron8/issues",
  "type": "module",
  "main": "dist/voron8.js",
  "module": "dist/voron8.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/voron8.js",
      "require": "./dist/voron8.umd.cjs",
      "default": "./dist/voron8.js"
    }
  },
  "unpkg": "dist/voron8.umd.js",
  "jsdelivr": "dist/voron8.umd.js",
  "files": [
    "dist",
    "src",
    "cpp",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "node scripts/bundle.mjs",
    "build:all": "npm run build:wasm && npm run build",
    "prepublishOnly": "npm run build",
    "test": "node --test"
  },
  "keywords": [
    "voronoi",
    "cgal",
    "wasm",
    "webassembly",
    "segment-voronoi",
    "medial-axis",
    "computational-geometry",
    "delaunay"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
